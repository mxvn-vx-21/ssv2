.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px}
.win{border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(12px);display:flex;flex-direction:column;transition:transform .3s}.win:hover{transform:translateY(-4px)}
.bar{display:flex;gap:8px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);color:var(--mut)}
.bar i{width:9px;height:9px;border-radius:50%;border:1px solid var(--line)}.bar span{margin-left:6px}
.thumb{height:130px;display:grid;place-items:center;font-weight:700;font-size:26px;border-bottom:1px solid var(--line);background:radial-gradient(circle at 70% 120%,rgba(155,184,255,.22),transparent 60%);overflow:hidden}
.thumb img{width:100%;height:100%;object-fit:cover}
.body{padding:18px;display:flex;flex-direction:column;gap:12px;flex:1}.meta{color:var(--mut);font-size:11px}
.tags{display:flex;flex-wrap:wrap;gap:6px}.tag{border:1px solid var(--line);padding:3px 8px;font-size:10px}
.acts{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap}.acts .btn{padding:9px 14px}
.price{font-size:44px;font-weight:700;margin:8px 0 14px}.tier ul{list-style:none;padding:0;display:grid;gap:8px;color:var(--mut)}.tier li::before{content:"✓ ";color:var(--fg)}
.tier{padding:24px;gap:6px}.note{color:var(--mut);margin-top:18px}
form{border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(12px);padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.f{display:grid;gap:6px}.f.w{grid-column:1/-1}label{color:var(--mut);font-size:10px}
input,select,textarea{background:transparent;border:1px solid var(--line);color:var(--fg);padding:11px;font:inherit;font-size:14px;width:100%}
select option{color:#080808}fieldset{border:0;display:flex;flex-wrap:wrap;gap:8px 16px}fieldset label{display:flex;gap:6px;align-items:center;width:auto}fieldset input{width:auto}
.err{color:#ff8a8a;font-size:12px;min-height:14px}#st{grid-column:1/-1;font-size:13px}
