section{padding:90px 0;border-top:1px solid var(--line)}
.hero{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;min-height:calc(100vh - 60px);border:0;padding:40px 0}
.eyebrow{color:var(--mut)}h1.big{font-size:clamp(56px,11vw,140px);line-height:.95;letter-spacing:-.03em;margin:18px 0}
