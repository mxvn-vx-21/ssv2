.js [data-st]{opacity:0}.ready [data-st]{animation:up .85s var(--e) both;animation-delay:calc(var(--st)*100ms + 800ms)}
@keyframes up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.js #stage{opacity:0;transition:opacity 1.3s ease .5s}.ready #stage{opacity:1}
.js [data-rv]{opacity:0;transition:opacity .8s var(--e),transform .9s var(--e),clip-path 1s var(--e);transition-delay:calc(var(--d,0)*90ms)}
[data-rv=up]{transform:translateY(26px)}[data-rv=scale]{transform:scale(.95)}[data-rv=left]{transform:translateX(-28px)}[data-rv=clip]{clip-path:inset(0 0 92% 0)}
.js [data-rv].in{opacity:1;transform:none;clip-path:inset(-60px)}
@keyframes heroOut{to{transform:translateY(70px) scale(.95);opacity:.3}}@keyframes textOut{to{transform:translateY(-26px);opacity:.45}}
