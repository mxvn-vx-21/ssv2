<style>
:root{color-scheme:dark;--bg:#080808;--s1:#0d0d0d;--s2:#131313;--s3:#1a1a1a;--g4:#262626;--g5:#3a3a3a;--g6:#5c5c5c;--g7:#8d8d8d;--g8:#bdbdbd;--fg:#fff;--mut:#8d8d8d;--line:rgba(255,255,255,.13);--glass:rgba(255,255,255,.05);--inv:#fff;--invfg:#080808;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:70px}
body{background:var(--bg);color:var(--fg);font:16px/1.5 'Space Grotesk',system-ui,sans-serif;overflow-x:hidden;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:96px 96px;background-attachment:fixed}
body::before{content:"";position:fixed;inset:0;background:radial-gradient(900px 600px at 80% 8%,rgba(255,255,255,.07),transparent 60%),radial-gradient(700px 500px at 5% 60%,rgba(140,160,200,.06),transparent 60%),var(--bg);opacity:.95;z-index:-1}
.m,.tag,label,.nav a,.btn{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
